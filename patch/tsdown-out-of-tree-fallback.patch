+/** Nearest ancestor package.json from the build cwd declaring `id`. */
+function outOfTreeManifest(id: string): WorkspaceManifest | undefined {
+  let dir = resolvePath(process.cwd())
+  for (;;) {
+    const manifestPath = resolvePath(dir, 'package.json')
+    if (existsSync(manifestPath)) {
+      const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as WorkspaceManifest
+      if (manifest.name === id) return manifest
+    }
+    const parent = dirname(dir)
+    if (parent === dir) return undefined
+    dir = parent
+  }
+}
