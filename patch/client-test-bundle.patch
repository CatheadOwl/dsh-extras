+
+/**
+ * Node-importable twin of the browser client bundle (local patch for
+ * out-of-tree component testing, upstream issue 20260830-1927): same entry,
+ * externals, purity gate, and CSS virtual loaders as {@link clientConfig},
+ * but ESM on the node platform without the `window.__ModuleLoader__`
+ * closure wrapper, emitted as `lib/client.test.js` next to the browser
+ * `lib/client.js`. Requested module-table rows stay bare imports; a spec
+ * supplies them (react) or mocks them (`vi.mock`) before importing the
+ * artifact. The style-injection modules guard on `typeof document`, so the
+ * import also succeeds outside jsdom.
+ */
+function clientTestConfig(id: string, entry: string): UserConfig {
+  const browser = clientConfig(id, entry)
+  return {
+    ...browser,
+    name: `${id}/client-test`,
+    format: 'esm',
+    platform: 'node',
+    outputOptions: {
+      ...browser.outputOptions,
+      entryFileNames: 'client.test.js',
+      banner: undefined,
+      footer: undefined,
+      intro: undefined,
+    },
   }
 }
 
